[Unit]
Description=Desktop_remoto signaling server
After=network-online.target
Wants=network-online.target

[Service]
# Only UDP TURN: webrtc-rs skips TCP TURN urls.
# TURN secret shared with coturn, handed over as a systemd credential (%d = credentials dir).
LoadCredential=turn-secret:/etc/desktop-remoto/turn-secret
ExecStart=/usr/local/bin/signaling --listen 127.0.0.1:8080 --data-dir /var/lib/signaling \
    --ice-server stun:@PUBLIC_IP@:3478 \
    --turn-url turn:@PUBLIC_IP@:3478?transport=udp \
    --turn-secret-file %d/turn-secret
Restart=on-failure
RestartSec=2
# Throwaway user; ids.json lives in /var/lib/signaling (StateDirectory).
DynamicUser=yes
StateDirectory=signaling
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target

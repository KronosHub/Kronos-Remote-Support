+/* Kronos: applies a new avctx->bit_rate (and rc_max_rate) to the running session. */
+static void vtenc_update_bit_rate(AVCodecContext *avctx, VTEncContext *vtctx)
+{
+    SInt32 bit_rate = avctx->bit_rate;
+    CFNumberRef num;
 
+    if (avctx->codec_id != AV_CODEC_ID_H264 || bit_rate <= 0 ||
+        avctx->bit_rate == vtctx->applied_bit_rate)
+        return;
+    vtctx->applied_bit_rate = avctx->bit_rate;
+
+    num = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &bit_rate);
+    if (num) {
+        VTSessionSetProperty(vtctx->session, kVTCompressionPropertyKey_AverageBitRate, num);
+        CFRelease(num);
+    }
+    if (avctx->rc_max_rate > 0) {
+        int64_t bytes = avctx->rc_max_rate >> 3, seconds = 1;
+        CFNumberRef values[2] = {
+            CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &bytes),
+            CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &seconds),
+        };
+        if (values[0] && values[1]) {
+            CFArrayRef limits = CFArrayCreate(kCFAllocatorDefault, (const void **)values, 2,
+                                              &kCFTypeArrayCallBacks);
+            if (limits) {
+                VTSessionSetProperty(vtctx->session,
+                                     kVTCompressionPropertyKey_DataRateLimits, limits);
+                CFRelease(limits);
+            }
+        }
+        if (values[0]) CFRelease(values[0]);
+        if (values[1]) CFRelease(values[1]);
+    }
+}

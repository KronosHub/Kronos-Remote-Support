{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main and viewer windows: app commands and service events only",
  "windows": ["main", "view-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen"
  ]
}
